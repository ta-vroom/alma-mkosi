#!/bin/bash
# This script runs inside the image during build.
#
# Available environment variables:
#   $SRCDIR   - Source directory (your project, mounted from host)
#   $DESTDIR  - Install destination (files here go into the final image)
#   $BUILDDIR - Persistent build directory (for incremental builds)
#
# This is a demonstration script. Replace with your actual build commands.

set -e

echo "=== mkosi build script ==="
echo "SRCDIR=$SRCDIR"
echo "DESTDIR=$DESTDIR"
echo "BUILDDIR=$BUILDDIR"

# Example: If your project uses cmake
# cd "$BUILDDIR"
# cmake "$SRCDIR" -DCMAKE_INSTALL_PREFIX=/usr
# make -j "$(nproc)"
# make install DESTDIR="$DESTDIR"

echo "=== Build complete ==="
