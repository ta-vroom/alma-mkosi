[Source]
Type=url-file
Path=https://github.com/ta-vroom/ubuntu-mkosi/releases/latest/download/
MatchPattern=alma_root-x86-64-verity_@v.raw

[Target]
Type=partition
Path=auto
MatchPartitionType=root-verity-x86-64:root-secondary-verity-x86-64
MatchPattern=alma_root_verity_@v
InstancesMax=2
ReadOnly=yes
Mode=0444