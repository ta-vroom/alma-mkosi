[Source]
Type=url-file
Path=https://github.com/ta-vroom/ubuntu-mkosi/releases/download/@v/
MatchPattern=alma_root-x86-64-verity_@v.raw

[Target]
Type=partition
Path=auto
MatchPartitionType=root-verity:root-verity-secondary
MatchPartitionLabel=alma_root_verity_@v
MatchPartitionUUID=
InstancesMax=2
ReadOnly=yes
Mode=0444