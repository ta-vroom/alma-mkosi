[Transfer]
ProtectVersion=%A

[Source]
Type=url-file
Path=https://github.com/ta-vroom/alma-mkosi/releases/latest/download/
MatchPattern=%M_@v_%a.efi

[Target]
Type=regular-file
Path=/EFI/Linux
PathRelativeTo=esp
MatchPattern=%M_@v_%a+@l-@d.efi \
             %M_@v_%a+@l.efi \
             %M_@v_%a.efi
Mode=0444
TriesLeft=3
TriesDone=0
InstancesMax=2
