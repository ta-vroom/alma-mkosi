[Unit]
Description=Overlay /etc for Persistent Configuration
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target
Wants=var.mount
After=var.mount

[Mount]
What=overlay
Where=/etc
Type=overlay
Options=lowerdir=/etc,upperdir=/var/etc,workdir=/var/.etc-work,nofail

[Install]
WantedBy=local-fs.target