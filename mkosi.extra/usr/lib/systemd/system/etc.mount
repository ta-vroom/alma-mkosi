[Unit]
Description=Overlay /etc for Persistent Configuration
DefaultDependencies=no
Conflicts=umount.target
Before=local-fs.target systemd-sysctl.service systemd-udevd.service
Requires=var.mount
After=var.mount

[Mount]
What=overlay
Where=/etc
Type=overlay
Options=lowerdir=/etc,upperdir=/var/etc,workdir=/var/.etc-work

[Install]
WantedBy=local-fs.target