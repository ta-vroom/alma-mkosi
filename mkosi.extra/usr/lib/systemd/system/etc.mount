[Unit]
Description=Overlay /etc for Persistent Configuration
DefaultDependencies=no
Conflicts=umount.target
After=var.mount
Requires=var.mount
Wants=systemd-tmpfiles-setup.service
OnFailure=etc-ephemeral-fallback.service

[Mount]
What=overlay
Where=/etc
Type=overlay
Options=lowerdir=/etc,upperdir=/var/etc,workdir=/var/.etc-work