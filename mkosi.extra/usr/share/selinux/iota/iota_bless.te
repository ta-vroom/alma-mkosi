module iota_bless 1.0;

require {
    type init_t;
    type systemd_importd_t;
    type dosfs_t;
    class file { create getattr setattr read write append open rename unlink lock };
    class dir  { getattr search read open write add_name remove_name };
}

# sysupdate / bless-boot finalizing and cleaning up on the ESP
allow init_t dosfs_t:dir  { getattr search read open write add_name remove_name };
allow init_t dosfs_t:file { create getattr setattr read write append open rename unlink lock };
